# .env.example
# Copy this to .env and fill in your actual values

# Razorpay API Keys (from your Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=your_actual_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Database Configuration
DATABASE_URL=sqlite:///./vaultup.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/vaultup_db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Session/Auth Configuration
SECRET_KEY=your_secret_key_for_sessions
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
